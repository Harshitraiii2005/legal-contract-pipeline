# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-32-plus-character-string

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://legal:legal@localhost:5432/legaldb
POSTGRES_PASSWORD=legal

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-6

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX=contract-clauses

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
S3_BUCKET=legal-contracts
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@legalai.example.com

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Misc ──────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000
